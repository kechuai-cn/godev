/* pages/git/home/page.wxss */

.container {
  min-height: 100vh;
  background: #f5f6fa;
}

/* =================== Tabs =================== */
.tabs {
  display: flex;
  background: #ffffff;
  padding: 0 32rpx;
  gap: 8rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.tab-item {
  position: relative;
  padding: 24rpx 24rpx 20rpx;
  font-size: 28rpx;
  color: #888;
  font-weight: 500;
  transition: color 0.2s;
}

.tab-active {
  color: #1c1e21;
  font-weight: 700;
}

.tab-indicator {
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 40rpx;
  height: 6rpx;
  border-radius: 3rpx;
}

/* =================== Account Bar =================== */
.account-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #ffffff;
  padding: 20rpx 32rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.account-info {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.account-avatar {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.account-avatar text {
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 700;
}

.account-text {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.account-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #1c1e21;
}

.account-platform {
  font-size: 22rpx;
  color: #888;
}

.account-arrow {
  font-size: 36rpx;
  color: #c0c4cc;
  line-height: 1;
}

/* =================== Search =================== */
.search-bar {
  padding: 16rpx 32rpx;
  background: #ffffff;
  border-bottom: 1rpx solid #f0f0f0;
}

.search-input-wrap {
  display: flex;
  align-items: center;
  background: #f5f6fa;
  border-radius: 16rpx;
  padding: 14rpx 20rpx;
  gap: 12rpx;
}

.search-icon {
  font-size: 28rpx;
  opacity: 0.5;
}

.search-input {
  flex: 1;
  font-size: 26rpx;
  color: #1c1e21;
}

/* =================== Empty State =================== */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 60rpx;
}

.empty-icon {
  font-size: 80rpx;
  line-height: 1;
  margin-bottom: 24rpx;
  color: #f4430c;
  opacity: 0.6;
}

.empty-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1c1e21;
  margin-bottom: 12rpx;
}

.empty-desc {
  font-size: 26rpx;
  color: #888;
  text-align: center;
  margin-bottom: 40rpx;
}

.empty-btn {
  background: #f4430c;
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 600;
  padding: 18rpx 48rpx;
  border-radius: 16rpx;
}

/* =================== Loading =================== */
.loading-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 0;
  gap: 20rpx;
}

.loading-spinner {
  width: 48rpx;
  height: 48rpx;
  border: 4rpx solid #f0f0f0;
  border-top-color: #f4430c;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-text {
  font-size: 26rpx;
  color: #888;
}

/* =================== Error =================== */
.error-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 60rpx;
  gap: 24rpx;
}

.error-text {
  font-size: 28rpx;
  color: #e74c3c;
  text-align: center;
}

.retry-btn {
  background: #f4430c;
  color: #ffffff;
  font-size: 26rpx;
  padding: 14rpx 40rpx;
  border-radius: 12rpx;
}

/* =================== Repo List =================== */
.repo-list {
  padding: 16rpx 24rpx;
}

.repo-card {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 28rpx 24rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.repo-card:active {
  transform: scale(0.98);
  opacity: 0.9;
}

.repo-header {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.repo-avatar {
  width: 52rpx;
  height: 52rpx;
  border-radius: 14rpx;
  background: linear-gradient(135deg, #f4430c 0%, #ff6b4a 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.repo-avatar-text {
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 1;
}

.repo-title-wrap {
  flex: 1;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.repo-name {
  font-size: 28rpx;
  font-weight: 700;
  color: #1c1e21;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.repo-fullname {
  font-size: 22rpx;
  color: #888;
  margin-top: 2rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.repo-private {
  background: #f0f2f5;
  border-radius: 8rpx;
  padding: 4rpx 12rpx;
  flex-shrink: 0;
}

.repo-private text {
  font-size: 20rpx;
  color: #888;
}

.repo-desc {
  font-size: 24rpx;
  color: #606770;
  line-height: 1.5;
  margin-bottom: 16rpx;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

/* =================== Repo Meta =================== */
.repo-meta {
  display: flex;
  align-items: center;
  gap: 24rpx;
  flex-wrap: wrap;
}

.meta-item {
  display: flex;
  align-items: center;
  gap: 6rpx;
  font-size: 22rpx;
  color: #888;
}

.lang-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
}

.meta-icon {
  font-size: 22rpx;
  color: #f39c12;
}

.meta-time {
  font-size: 22rpx;
  color: #b0b3b8;
  margin-left: auto;
}

/* =================== No Result =================== */
.no-result {
  display: flex;
  justify-content: center;
  padding: 80rpx 0;
}

.no-result-text {
  font-size: 28rpx;
  color: #b0b3b8;
}

/* =================== Bottom Space =================== */
.bottom-space {
  height: 60rpx;
}
