/* pages/git/home/page.wxss */

.container {
  min-height: 100vh;
  background: #f5f6fa;
}

/* =================== Account Bar（顶部第一栏） =================== */
.account-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #ffffff;
  padding: 20rpx 32rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.account-left {
  display: flex;
  align-items: center;
  gap: 16rpx;
  flex: 1;
  overflow: hidden;
}

.account-avatar {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.account-avatar text {
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 700;
}

.account-text {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  overflow: hidden;
}

.account-name {
  font-size: 30rpx;
  font-weight: 700;
  color: #1c1e21;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.account-platform {
  font-size: 22rpx;
  color: #888;
}

.account-right {
  display: flex;
  align-items: center;
  gap: 6rpx;
  flex-shrink: 0;
  margin-left: 16rpx;
}

.switch-icon {
  font-size: 28rpx;
  color: #888;
}

.switch-label {
  font-size: 22rpx;
  color: #888;
}

/* =================== Search Bar（顶部第二栏） =================== */
.search-bar {
  padding: 16rpx 24rpx;
  background: #ffffff;
  border-bottom: 1rpx solid #f0f0f0;
}

.search-input-wrap {
  display: flex;
  align-items: center;
  background: #f5f6fa;
  border-radius: 16rpx;
  padding: 14rpx 20rpx;
  gap: 12rpx;
}

.search-icon {
  font-size: 28rpx;
  opacity: 0.5;
  flex-shrink: 0;
}

.search-input {
  flex: 1;
  font-size: 26rpx;
  color: #1c1e21;
}

.search-clear {
  width: 36rpx;
  height: 36rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  background: #ccc;
  border-radius: 50%;
}

.search-clear text {
  font-size: 20rpx;
  color: #fff;
  line-height: 1;
}

/* =================== Empty State =================== */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 60rpx;
}

.empty-icon {
  font-size: 80rpx;
  line-height: 1;
  margin-bottom: 24rpx;
  color: #f4430c;
  opacity: 0.6;
}

.empty-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1c1e21;
  margin-bottom: 12rpx;
}

.empty-desc {
  font-size: 26rpx;
  color: #888;
  text-align: center;
  margin-bottom: 40rpx;
}

.empty-btn {
  background: #f4430c;
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 600;
  padding: 18rpx 48rpx;
  border-radius: 16rpx;
}

/* =================== Loading =================== */
.loading-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 0;
  gap: 20rpx;
}

.loading-spinner {
  width: 48rpx;
  height: 48rpx;
  border: 4rpx solid #f0f0f0;
  border-top-color: #f4430c;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-text {
  font-size: 26rpx;
  color: #888;
}

/* =================== Error =================== */
.error-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 60rpx;
  gap: 24rpx;
}

.error-text {
  font-size: 28rpx;
  color: #e74c3c;
  text-align: center;
}

.retry-btn {
  background: #f4430c;
  color: #ffffff;
  font-size: 26rpx;
  padding: 14rpx 40rpx;
  border-radius: 12rpx;
}

/* =================== Repo List =================== */
.repo-list {
  padding: 16rpx 24rpx;
}

.repo-card {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 28rpx 24rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.repo-card:active {
  transform: scale(0.98);
  opacity: 0.9;
}

/* --- Repo Header --- */
.repo-header {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.repo-avatar {
  width: 52rpx;
  height: 52rpx;
  border-radius: 14rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.repo-avatar-text {
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 1;
}

.repo-title-wrap {
  flex: 1;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.repo-name-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex-wrap: wrap;
}

.repo-name {
  font-size: 28rpx;
  font-weight: 700;
  color: #1c1e21;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* --- Badges（私有 + 归档） --- */
.repo-badges {
  display: flex;
  gap: 8rpx;
  flex-shrink: 0;
}

.badge {
  border-radius: 8rpx;
  padding: 2rpx 12rpx;
  flex-shrink: 0;
}

.badge text {
  font-size: 20rpx;
  font-weight: 500;
  line-height: 1.6;
}

.badge-private {
  background: #f0f2f5;
}

.badge-private text {
  color: #888;
}

.badge-archived {
  background: #f5f0e6;
}

.badge-archived text {
  color: #9a7b00;
}

.repo-fullname {
  font-size: 22rpx;
  color: #888;
  margin-top: 4rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* --- Repo Description --- */
.repo-desc {
  font-size: 24rpx;
  color: #606770;
  line-height: 1.5;
  margin-bottom: 16rpx;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

/* =================== Repo Meta =================== */
.repo-meta {
  display: flex;
  align-items: center;
  gap: 24rpx;
  flex-wrap: wrap;
}

.meta-item {
  display: flex;
  align-items: center;
  gap: 6rpx;
  font-size: 22rpx;
  color: #888;
}

.lang-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
}

.meta-icon {
  font-size: 22rpx;
  color: #f39c12;
}

.meta-time {
  font-size: 22rpx;
  color: #b0b3b8;
  margin-left: auto;
}

/* =================== Load More =================== */
.load-more {
  display: flex;
  justify-content: center;
  padding: 24rpx 0 8rpx;
}

.load-more-btn {
  background: #ffffff;
  color: #1a73e8;
  font-size: 26rpx;
  font-weight: 600;
  padding: 16rpx 48rpx;
  border-radius: 16rpx;
  border: 2rpx solid #1a73e8;
}

.load-more-loading {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 16rpx 0;
}

.loading-spinner-sm {
  width: 32rpx;
  height: 32rpx;
  border: 3rpx solid #f0f0f0;
  border-top-color: #1a73e8;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

.load-more-loading text {
  font-size: 24rpx;
  color: #888;
}

.load-end {
  display: flex;
  justify-content: center;
  padding: 24rpx 0 8rpx;
}

.load-end text {
  font-size: 24rpx;
  color: #c0c4cc;
}

/* =================== No Result =================== */
.no-result {
  display: flex;
  justify-content: center;
  padding: 80rpx 0;
}

.no-result-text {
  font-size: 28rpx;
  color: #b0b3b8;
}

/* =================== Bottom Space =================== */
.bottom-space {
  height: 60rpx;
}
