/* pages/git/home/page.wxss */

.container {
  min-height: 100vh;
  background:
    radial-gradient(circle at top, rgba(45, 74, 165, 0.24), transparent 32%),
    linear-gradient(180deg, #071024 0%, #08142e 46%, #091120 100%);
}

.page-shell {
  padding: 24rpx;
}

.account-panel,
.search-bar,
.repo-card,
.empty-state,
.loading-state,
.error-state,
.no-result,
.load-more-btn {
  background: rgba(23, 32, 59, 0.92);
  border: 1rpx solid rgba(255, 255, 255, 0.06);
  box-shadow: 0 10rpx 30rpx rgba(0, 0, 0, 0.18);
}

.account-panel {
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-radius: 28rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
}

.account-left {
  display: flex;
  align-items: center;
  gap: 18rpx;
  flex: 1;
  min-width: 0;
}

.account-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.18);
}

.account-avatar text {
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 700;
}

.account-text {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  min-width: 0;
}

.account-overline {
  font-size: 20rpx;
  text-transform: uppercase;
  letter-spacing: 1.5rpx;
  color: rgba(255, 255, 255, 0.48);
}

.account-name {
  font-size: 40rpx;
  line-height: 1.2;
  font-weight: 700;
  color: #f3f6ff;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.account-platform {
  font-size: 24rpx;
  color: rgba(222, 229, 255, 0.72);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.account-right {
  width: 64rpx;
  height: 64rpx;
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-left: 16rpx;
  background: rgba(255, 255, 255, 0.06);
}

.switch-icon {
  font-size: 30rpx;
  color: #eef3ff;
  line-height: 1;
}

.search-bar {
  border-radius: 24rpx;
  padding: 10rpx 20rpx;
  margin-bottom: 36rpx;
}

.search-input-wrap {
  display: flex;
  align-items: center;
  gap: 16rpx;
  min-height: 72rpx;
}

.search-icon {
  font-size: 30rpx;
  color: rgba(255, 255, 255, 0.68);
  flex-shrink: 0;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  color: #f3f6ff;
}

.search-placeholder {
  color: rgba(222, 229, 255, 0.42);
}

.search-clear {
  width: 38rpx;
  height: 38rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.12);
  flex-shrink: 0;
}

.search-clear text {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.86);
  line-height: 1;
}

.empty-state,
.loading-state,
.error-state,
.no-result {
  border-radius: 28rpx;
  padding: 80rpx 48rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.empty-icon {
  min-width: 120rpx;
  height: 120rpx;
  padding: 0 28rpx;
  border-radius: 30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(244, 67, 12, 0.14);
  color: #ff8f68;
  font-size: 34rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
  margin-bottom: 28rpx;
}

.empty-title,
.error-title,
.no-result-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #f3f6ff;
  margin-bottom: 14rpx;
}

.empty-desc,
.loading-text,
.error-text,
.no-result-text {
  font-size: 26rpx;
  line-height: 1.6;
  color: rgba(222, 229, 255, 0.64);
}

.empty-btn,
.retry-btn {
  margin-top: 36rpx;
  min-width: 220rpx;
  padding: 18rpx 40rpx;
  border-radius: 18rpx;
  background: linear-gradient(135deg, #ff6b3d 0%, #f4430c 100%);
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 600;
  text-align: center;
}

.loading-state {
  gap: 20rpx;
}

.loading-spinner {
  width: 52rpx;
  height: 52rpx;
  border: 4rpx solid rgba(255, 255, 255, 0.12);
  border-top-color: #ff865f;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}

.error-text {
  color: #ffb1b1;
}

.repo-section {
  margin-top: 4rpx;
}

.section-header {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.section-title {
  display: block;
  font-size: 44rpx;
  font-weight: 700;
  color: #f5f7ff;
  line-height: 1.2;
}

.section-subtitle {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: rgba(222, 229, 255, 0.58);
}

.repo-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.repo-card {
  border-radius: 28rpx;
  padding: 28rpx;
}

.repo-card:active {
  transform: scale(0.985);
  opacity: 0.95;
}

.repo-header {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  margin-bottom: 18rpx;
}

.repo-title-wrap {
  flex: 1;
  min-width: 0;
}

.repo-name-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex-wrap: wrap;
}

.repo-name {
  max-width: 100%;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 1.35;
  color: #eef3ff;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.repo-badges {
  display: flex;
  align-items: center;
  gap: 8rpx;
  flex-shrink: 0;
}

.badge {
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
}

.badge text {
  font-size: 18rpx;
  line-height: 1.4;
  color: #f8fbff;
}

.badge-private {
  background: rgba(98, 118, 165, 0.3);
}

.badge-archived {
  background: rgba(191, 138, 61, 0.26);
}

.repo-more {
  font-size: 30rpx;
  line-height: 1;
  color: rgba(255, 255, 255, 0.54);
  flex-shrink: 0;
}

.repo-desc {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
  margin-bottom: 20rpx;
  font-size: 25rpx;
  line-height: 1.55;
  color: rgba(222, 229, 255, 0.74);
}

.repo-desc--muted {
  color: rgba(222, 229, 255, 0.36);
}

.repo-meta {
  display: flex;
  align-items: center;
  gap: 18rpx;
  flex-wrap: wrap;
}

.meta-pill,
.meta-item {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  min-height: 40rpx;
  padding: 0 14rpx;
  border-radius: 12rpx;
  background: rgba(255, 255, 255, 0.06);
  font-size: 20rpx;
  color: rgba(245, 247, 255, 0.78);
}

.meta-pill text {
  text-transform: uppercase;
  letter-spacing: 1rpx;
}

.lang-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.meta-icon {
  font-size: 20rpx;
  color: #ffd875;
}

.meta-time {
  margin-left: auto;
  font-size: 22rpx;
  color: rgba(222, 229, 255, 0.5);
}

.load-more {
  display: flex;
  justify-content: center;
  padding: 10rpx 0 0;
}

.load-more-btn {
  min-width: 220rpx;
  padding: 18rpx 40rpx;
  border-radius: 18rpx;
  text-align: center;
}

.load-more-btn text {
  font-size: 24rpx;
  color: #dfe7ff;
}

.load-more-loading {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 18rpx 0;
}

.loading-spinner-sm {
  width: 32rpx;
  height: 32rpx;
  border: 3rpx solid rgba(255, 255, 255, 0.12);
  border-top-color: #8eb1ff;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

.load-more-loading text,
.load-end text {
  font-size: 24rpx;
  color: rgba(222, 229, 255, 0.54);
}

.load-end {
  display: flex;
  justify-content: center;
  padding: 8rpx 0 0;
}

.no-result {
  margin-top: 20rpx;
}

.bottom-space {
  height: 48rpx;
}
