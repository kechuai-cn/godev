.container {
  min-height: 100vh;
  background:
    radial-gradient(circle at top, rgba(44, 77, 171, 0.22), transparent 30%),
    linear-gradient(180deg, #06102a 0%, #07122d 52%, #09101f 100%);
}

.page-shell {
  padding: 24rpx 24rpx 160rpx;
}

.token-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.token-card,
.empty-state {
  background: rgba(23, 32, 59, 0.92);
  border: 1rpx solid rgba(255, 255, 255, 0.06);
  border-radius: 28rpx;
  box-shadow: 0 12rpx 30rpx rgba(0, 0, 0, 0.2);
}

.token-card {
  padding: 28rpx;
}

.token-active {
  box-shadow:
    0 12rpx 30rpx rgba(0, 0, 0, 0.2),
    0 0 0 1rpx rgba(110, 235, 175, 0.14) inset;
}

.token-header {
  display: flex;
  align-items: flex-start;
  gap: 18rpx;
}

.token-platform-badge {
  width: 68rpx;
  height: 68rpx;
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  font-size: 24rpx;
  font-weight: 800;
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.12);
}

.token-info {
  flex: 1;
  min-width: 0;
}

.token-name-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex-wrap: wrap;
}

.token-name {
  font-size: 30rpx;
  font-weight: 700;
  line-height: 1.35;
  color: #eef3ff;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.active-tag {
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  background: rgba(86, 212, 149, 0.14);
}

.active-tag text {
  font-size: 18rpx;
  font-weight: 600;
  color: #8ae0b4;
}

.token-category {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  font-weight: 700;
  letter-spacing: 1.6rpx;
  color: rgba(212, 223, 255, 0.48);
}

.token-detail-list {
  margin-top: 26rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.detail-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.detail-icon {
  width: 28rpx;
  text-align: center;
  font-size: 20rpx;
  color: rgba(219, 228, 255, 0.72);
  flex-shrink: 0;
}

.detail-text {
  font-size: 26rpx;
  line-height: 1.5;
  color: rgba(236, 241, 255, 0.84);
}

.status-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 26rpx;
}

.status-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.status-dot--active {
  background: #6fe8ac;
  box-shadow: 0 0 10rpx rgba(111, 232, 172, 0.8);
}

.status-dot--idle {
  background: rgba(173, 192, 247, 0.64);
}

.status-text {
  font-size: 24rpx;
  color: rgba(222, 229, 255, 0.64);
}

.card-divider {
  height: 1rpx;
  margin: 22rpx 0;
  background: rgba(255, 255, 255, 0.06);
}

.token-actions {
  display: flex;
  gap: 16rpx;
}

.action-btn {
  flex: 1;
  min-height: 64rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.action-btn text {
  font-size: 26rpx;
  font-weight: 600;
}

.action-use,
.action-edit {
  background: rgba(17, 26, 53, 0.92);
}

.action-use text,
.action-edit text {
  color: #e6edff;
}

.action-delete {
  background: rgba(91, 41, 54, 0.56);
}

.action-delete text {
  color: #ffc0c8;
}

.empty-state {
  padding: 100rpx 48rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.empty-icon {
  min-width: 120rpx;
  height: 120rpx;
  padding: 0 30rpx;
  border-radius: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(92, 115, 174, 0.18);
  color: #d9e4ff;
  font-size: 30rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
  margin-bottom: 26rpx;
}

.empty-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #f3f6ff;
  margin-bottom: 12rpx;
}

.empty-desc {
  font-size: 26rpx;
  line-height: 1.6;
  color: rgba(222, 229, 255, 0.62);
}

.add-btn {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  bottom: 40rpx;
  min-height: 92rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  background: linear-gradient(180deg, #b9c8f4 0%, #a9bbec 100%);
  box-shadow: 0 12rpx 28rpx rgba(111, 144, 228, 0.28);
}

.add-btn-icon,
.add-btn-text {
  color: #0f2f69;
  font-size: 30rpx;
  font-weight: 700;
}
