
.container {
  min-height: 100vh;
  background: #f5f6fa;
  padding-bottom: 140rpx;
}

.header {
  padding: 32rpx 32rpx 16rpx;
}

.header-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #1c1e21;
  display: block;
}

.header-desc {
  font-size: 24rpx;
  color: #888;
  margin-top: 6rpx;
  display: block;
}

/* =================== Token List =================== */
.token-list {
  padding: 8rpx 24rpx;
}

.token-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #ffffff;
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 12rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
  border-left: 6rpx solid transparent;
}

.token-active {
  border-left-color: #16a34a;
  background: #f0fdf4;
}

.token-left {
  display: flex;
  align-items: center;
  gap: 16rpx;
  flex: 1;
  overflow: hidden;
}

.token-platform-badge {
  width: 56rpx;
  height: 56rpx;
  border-radius: 14rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  font-size: 22rpx;
  font-weight: 800;
}

.token-info {
  display: flex;
  flex-direction: column;
  overflow: hidden;
  gap: 4rpx;
}

.token-name-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.token-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #1c1e21;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.active-tag {
  background: #dcfce7;
  border-radius: 8rpx;
  padding: 2rpx 12rpx;
  flex-shrink: 0;
}

.active-tag text {
  font-size: 20rpx;
  color: #16a34a;
  font-weight: 500;
}

/* =================== Meta =================== */
.token-meta {
  display: flex;
  align-items: center;
  gap: 6rpx;
  margin-top: 4rpx;
  flex-wrap: wrap;
}

.token-platform-label {
  font-size: 22rpx;
  color: #555;
  font-weight: 500;
}

.token-sep {
  font-size: 20rpx;
  color: #ccc;
}

.token-auth {
  font-size: 22rpx;
  color: #888;
}

.token-username {
  font-size: 22rpx;
  color: #888;
  margin-top: 4rpx;
}

/* =================== Actions =================== */
.token-actions {
  display: flex;
  gap: 12rpx;
  flex-shrink: 0;
}

.action-btn {
  padding: 10rpx 20rpx;
  border-radius: 12rpx;
  font-size: 22rpx;
}

.action-edit {
  background: #e8f0fe;
  color: #1a73e8;
}

.action-delete {
  background: #fef3e2;
  color: #e8710a;
}

.action-use {
  background: #dcfce7;
  color: #16a34a;
  font-weight: 700;
}

/* =================== Empty =================== */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 60rpx;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.empty-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1c1e21;
  margin-bottom: 8rpx;
}

.empty-desc {
  font-size: 26rpx;
  color: #888;
}

/* =================== Add Button =================== */
.add-btn {
  position: fixed;
  bottom: 60rpx;
  left: 50%;
  transform: translateX(-50%);
  display: flex;
  align-items: center;
  gap: 8rpx;
  background: #f4430c;
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 600;
  padding: 22rpx 48rpx;
  border-radius: 40rpx;
  box-shadow: 0 8rpx 24rpx rgba(244, 67, 12, 0.35);
}

.add-btn-icon {
  font-size: 32rpx;
  font-weight: 300;
}
