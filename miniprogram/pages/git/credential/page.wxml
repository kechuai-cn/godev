<!-- pages/git/credential/page.wxml -->
<view class="container">
  <view class="page-shell">
    <view class="token-list" wx:if="{{credentials.length > 0}}">
      <view
        class="token-card {{item.tokenActiveClass}}"
        wx:for="{{credentials}}"
        wx:key="id"
      >
        <view class="token-header">
          <view class="token-platform-badge" style="background:{{item.platformBg}};color:{{item.platformColor}};">
            <text>{{item.platformShort}}</text>
          </view>
          <view class="token-info">
            <view class="token-name-row">
              <text class="token-name">{{item.name}}</text>
              <view class="active-tag" wx:if="{{item.isActive}}">
                <text>当前连接</text>
              </view>
            </view>
            <text class="token-category">GIT REPOSITORY</text>
          </view>
        </view>

        <view class="token-detail-list">
          <view class="detail-row">
            <text class="detail-icon">◈</text>
            <text class="detail-text">{{item.platformLabel}}</text>
          </view>
          <view class="detail-row">
            <text class="detail-icon">⌁</text>
            <text class="detail-text">{{item.authTypeLabel}}</text>
          </view>
          <view class="detail-row">
            <text class="detail-icon">•</text>
            <text class="detail-text">{{item.displayUsername}}</text>
          </view>
        </view>

        <view class="status-row">
          <view class="status-dot {{item.isActive ? 'status-dot--active' : 'status-dot--idle'}}"></view>
          <text class="status-text" wx:if="{{item.isActive}}">当前活跃凭证</text>
          <text class="status-text" wx:else>可切换使用</text>
        </view>

        <view class="card-divider"></view>

        <view class="token-actions">
          <view
            class="action-btn action-use"
            wx:if="{{item.isNotActive}}"
            data-id="{{item.id}}"
            bindtap="onSetActive"
          >
            <text>使用</text>
          </view>
          <view class="action-btn action-edit" data-id="{{item.id}}" bindtap="onEditCredential">
            <text>编辑</text>
          </view>
          <view class="action-btn action-delete" data-id="{{item.id}}" bindtap="onDeleteCredential">
            <text>删除</text>
          </view>
        </view>
      </view>
    </view>

    <view class="empty-state" wx:else>
      <view class="empty-icon">KEY</view>
      <text class="empty-title">还没有 Git 凭证</text>
      <text class="empty-desc">新增一个平台凭证后，就可以切换账号并访问仓库列表。</text>
    </view>

    <view class="add-btn" bindtap="onAddCredential">
      <text class="add-btn-icon">＋</text>
      <text class="add-btn-text">添加凭证</text>
    </view>
  </view>
</view>
