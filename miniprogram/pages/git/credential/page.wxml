<view class="container">

  <view class="header">
  </view>

  <!-- 凭证列表 -->
  <view class="token-list" wx:if="{{credentials.length > 0}}">
    <view
      class="token-card {{item.tokenActiveClass}}"
      wx:for="{{credentials}}"
      wx:key="id"
    >
      <view class="token-left">
        <view class="token-platform-badge" style="background:{{item.platformBg}};color:{{item.platformColor}};">
          <text>{{item.platformShort}}</text>
        </view>
        <view class="token-info">
          <view class="token-name-row">
            <text class="token-name">{{item.name}}</text>
            <view class="active-tag" wx:if="{{item.isActive}}">
              <text>当前使用</text>
            </view>
          </view>
          <view class="token-meta">
            <text class="token-platform-label">{{item.platformLabel}}</text>
            <text class="token-sep">·</text>
            <text class="token-auth">{{item.authTypeLabel}}</text>
            <text class="token-sep">·</text>
            <text class="token-username">{{item.displayUsername}}</text>
          </view>
        </view>
      </view>

      <view class="token-actions">
        <!-- 非活跃账号：使用按钮 -->
        <view
          class="action-btn action-use"
          wx:if="{{item.isNotActive}}"
          data-id="{{item.id}}"
          bindtap="onSetActive"
        >
          <text>使用</text>
        </view>
        <view class="action-btn action-edit" data-id="{{item.id}}" bindtap="onEditCredential">
          <text>编辑</text>
        </view>
        <view class="action-btn action-delete" data-id="{{item.id}}" bindtap="onDeleteCredential">
          <text>删除</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 空状态 -->
  <view class="empty-state" wx:else>
    <text class="empty-icon">🔑</text>
    <text class="empty-title">暂无凭据</text>
    <text class="empty-desc">添加凭据后即可访问你的 Git 仓库</text>
  </view>

  <navigator class="add-btn" url="/pages/git/credential-edit/page">
    <text class="add-btn-icon">+</text>
    <text class="add-btn-text">添加凭据</text>
  </navigator>

</view>
