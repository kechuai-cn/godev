/* pages/git/account/edit/page.wxss */

.container {
  min-height: 100vh;
  background: #f5f6fa;
  padding: 24rpx;
}

/* =================== Form =================== */
.form-section {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
}

.section-label {
  font-size: 24rpx;
  color: #888;
  font-weight: 500;
  display: block;
  margin-bottom: 12rpx;
}

.form-input {
  background: #f5f6fa;
  border-radius: 12rpx;
  padding: 18rpx 20rpx;
  font-size: 28rpx;
  color: #1c1e21;
}

.form-picker {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #f5f6fa;
  border-radius: 12rpx;
  padding: 18rpx 20rpx;
  font-size: 28rpx;
  color: #1c1e21;
}

.picker-arrow {
  color: #b0b3b8;
  font-size: 24rpx;
}

.toggle-pwd {
  margin-top: 12rpx;
  align-self: flex-end;
}

.toggle-pwd text {
  font-size: 24rpx;
  color: #1a73e8;
}

/* =================== Tip =================== */
.form-tip {
  padding: 16rpx 8rpx;
}

.form-tip text {
  font-size: 22rpx;
  color: #b0b3b8;
  line-height: 1.6;
}

/* =================== Hint =================== */
.form-hint {
  font-size: 22rpx;
  color: #b0b3b8;
  margin-top: 8rpx;
  display: block;
}

/* =================== Test Button =================== */
.test-btn {
  margin-top: 16rpx;
  background: #ffffff;
  color: #1a73e8;
  font-size: 28rpx;
  font-weight: 600;
  text-align: center;
  padding: 20rpx;
  border-radius: 20rpx;
  border: 2rpx solid #1a73e8;
}

/* =================== Test Result =================== */
.test-result {
  display: flex;
  align-items: center;
  margin-top: 16rpx;
  padding: 20rpx 24rpx;
  border-radius: 16rpx;
}

.test-success {
  background: #f0fdf4;
}

.test-fail {
  background: #fef2f2;
}

.test-icon {
  font-size: 32rpx;
  font-weight: 700;
  margin-right: 16rpx;
}

.test-success .test-icon {
  color: #16a34a;
}

.test-fail .test-icon {
  color: #dc2626;
}

.test-info {
  display: flex;
  flex-direction: column;
}

.test-msg {
  font-size: 26rpx;
  font-weight: 600;
}

.test-success .test-msg {
  color: #16a34a;
}

.test-fail .test-msg {
  color: #dc2626;
}

.test-user {
  font-size: 24rpx;
  margin-top: 4rpx;
}

.test-success .test-user {
  color: #15803d;
}

.test-fail .test-user {
  color: #b91c1c;
}

/* =================== Save Button =================== */
.save-btn {
  margin-top: 40rpx;
  background: #f4430c;
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 600;
  text-align: center;
  padding: 24rpx;
  border-radius: 20rpx;
  box-shadow: 0 8rpx 24rpx rgba(244, 67, 12, 0.3);
}

.btn-disabled {
  opacity: 0.5;
}
