/* pages/validator/edit/page.wxss */
.container {
  min-height: 100vh;
  background: var(--color-background);
}

.page-shell {
  padding: 24rpx 24rpx 60rpx;
}

.form-card {
  background: var(--color-surface);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-sm);
  padding: 12rpx 28rpx;
}

.form-row {
  display: flex;
  align-items: center;
  min-height: 96rpx;
}

.form-label {
  width: 160rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-text-primary);
  flex-shrink: 0;
}

.form-input {
  flex: 1;
  font-size: 28rpx;
  color: var(--color-text-primary);
  text-align: right;
}

.form-input--num {
  text-align: right;
}

.form-placeholder {
  color: var(--color-text-hint);
}

.form-divider {
  height: 1rpx;
  background: var(--color-border);
}

.form-row--secret {
  align-items: center;
}

.secret-wrap {
  flex: 1;
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.secret-wrap .form-input {
  flex: 1;
  text-align: left;
}

.scan-btn {
  flex-shrink: 0;
  padding: 12rpx 24rpx;
  border-radius: 999rpx;
  background: var(--color-primary-light);
}

.scan-btn text {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--color-primary);
}

.form-error {
  display: block;
  padding: 0 188rpx 16rpx 188rpx;
  font-size: 24rpx;
  color: var(--color-error);
}

.form-hint {
  padding: 16rpx 4rpx 24rpx;
}

.form-hint text {
  font-size: 24rpx;
  line-height: 1.6;
  color: var(--color-text-secondary);
}

.preview-card {
  margin-top: 24rpx;
  background: var(--color-surface);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-sm);
  padding: 36rpx 28rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
}

.preview-label {
  font-size: 24rpx;
  color: var(--color-text-secondary);
}

.preview-code {
  font-size: 60rpx;
  font-weight: 700;
  letter-spacing: 8rpx;
  color: var(--color-primary);
  font-family: 'Courier New', monospace;
}

.save-btn {
  margin-top: 40rpx;
  min-height: 92rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--color-primary);
  box-shadow: 0 12rpx 28rpx rgba(26, 115, 232, 0.28);
}

.save-btn text {
  color: #fff;
  font-size: 30rpx;
  font-weight: 700;
}
