/* pages/home/page.wxss */

.container {
  min-height: 100vh;
  background-color: #f5f6fa;
  padding-bottom: 60rpx;
}

/* =================== Feature Grid =================== */
.feature-grid {
  padding: 8rpx 24rpx 0;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 32rpx;
}

.feature-card {
  position: relative;
  background: #ffffff;
  border-radius: 24rpx;
  padding: 28rpx 24rpx 24rpx;
  display: flex;
  flex-direction: column;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
  overflow: hidden;
  transition: transform 0.15s ease, box-shadow 0.15s ease;
  active-state: true;
}

.feature-card:active {
  transform: scale(0.97);
  box-shadow: 0 1rpx 6rpx rgba(0, 0, 0, 0.04);
}

/* 角标 */
.badge {
  position: absolute;
  top: 16rpx;
  right: 16rpx;
  background: #f0f2f5;
  border-radius: 20rpx;
  padding: 4rpx 12rpx;
}

.badge text {
  font-size: 18rpx;
  color: #888;
  font-weight: 500;
}

/* 图标区域 */
.card-icon {
  width: 188rpx;
  height: 188rpx;
  margin: auto;
  border-radius: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 20rpx;
}

.icon-char {
  font-size: 84rpx;
  line-height: 1;
}

.card-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #1c1e21;
  line-height: 1.3;
  text-align: center;
}

/* =================== Footer =================== */
.footer {
  display: flex;
  justify-content: center;
  margin-top: 60rpx;
  font-size: 24rpx;
  color: #bbb;
}
